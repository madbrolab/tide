{
  "format": "tide.host-capabilities/1",
  "sdk": 2,
  "timezone": "Asia/Shanghai",
  "methods": [
    {
      "path": "ctx.browser.title",
      "summary": "通过浏览器组件离线运行页面脚本后读取标题",
      "execution": "host",
      "lifetime": "both",
      "signature": "title(html: string): Promise<string>"
    },
    {
      "path": "ctx.call",
      "summary": "跨插件动作调用；持久任务中建立子任务",
      "execution": "host",
      "lifetime": "both",
      "signature": "call(targetAction: string, input: JSONObject): Promise<JSONValue>"
    },
    {
      "path": "ctx.components.call",
      "summary": "调用已安装官方组件，进入共享组件调度器",
      "execution": "host",
      "lifetime": "both",
      "signature": "call(id: string, operation: string, args?: JSONObject): Promise<JSONValue>"
    },
    {
      "path": "ctx.connection",
      "summary": "本次凭据种类、UA 与源文件状态；不返回凭据",
      "execution": "host",
      "lifetime": "both",
      "signature": "connection(): Promise<Connection>"
    },
    {
      "path": "ctx.crypto.aesCBC",
      "summary": "AES-CBC；所有字节用 hex，插件负责填充",
      "execution": "host",
      "lifetime": "both",
      "signature": "aesCBC(mode: string, keyHex: string, ivHex: string, dataHex: string): Promise<string>"
    },
    {
      "path": "ctx.crypto.digest",
      "summary": "UTF-8 文本 sha1/sha256/md5 摘要",
      "execution": "host",
      "lifetime": "both",
      "signature": "digest(algorithm: Digest, text: string): Promise<string>"
    },
    {
      "path": "ctx.crypto.hmacSHA1",
      "summary": "UTF-8 文本 HMAC-SHA1，返回十六进制",
      "execution": "host",
      "lifetime": "both",
      "signature": "hmacSHA1(key: string, text: string): Promise<string>"
    },
    {
      "path": "ctx.db.exec",
      "summary": "私有 SQLite 参数化写入，返回受影响行数",
      "execution": "host",
      "lifetime": "both",
      "signature": "exec(sql: string, params?: SQLValue[]): Promise<number>"
    },
    {
      "path": "ctx.db.query",
      "summary": "私有 SQLite 参数化查询；最多 200 行及 128 KiB",
      "execution": "host",
      "lifetime": "both",
      "signature": "query(sql: string, params?: SQLValue[]): Promise<Row[]>"
    },
    {
      "path": "ctx.emit",
      "summary": "同调用链顺序执行启用的事件订阅者",
      "execution": "host",
      "lifetime": "both",
      "signature": "emit(event: string, input: JSONObject): Promise<number>"
    },
    {
      "path": "ctx.fs.appendBytes",
      "summary": "原生字节追加写入",
      "execution": "engine",
      "lifetime": "both",
      "signature": "appendBytes(path: string, bytes: Uint8Array): Promise<boolean>"
    },
    {
      "path": "ctx.fs.chmod",
      "summary": "修改 POSIX 权限",
      "execution": "engine",
      "lifetime": "both",
      "signature": "chmod(path: string, mode: number): Promise<boolean>"
    },
    {
      "path": "ctx.fs.copy",
      "summary": "复制文件或目录；目录须 recursive",
      "execution": "engine",
      "lifetime": "both",
      "signature": "copy(path: string, destination: string, options?: Recursive): Promise<boolean>"
    },
    {
      "path": "ctx.fs.hashRange",
      "summary": "普通路径本地计算；@source 使用宿主源文件句柄，区间最多 16 MiB",
      "execution": "engine",
      "lifetime": "both",
      "signature": "hashRange(path: string, offset: number, length: number, algorithm?: Digest): Promise<string>"
    },
    {
      "path": "ctx.fs.link",
      "summary": "创建硬链接",
      "execution": "engine",
      "lifetime": "both",
      "signature": "link(source: string, destination: string): Promise<boolean>"
    },
    {
      "path": "ctx.fs.list",
      "summary": "分页列目录，next 为下一偏移或 null",
      "execution": "engine",
      "lifetime": "both",
      "signature": "list(path: string, offset?: number): Promise<FilePage>"
    },
    {
      "path": "ctx.fs.lstat",
      "summary": "读取链接自身信息",
      "execution": "engine",
      "lifetime": "both",
      "signature": "lstat(path: string): Promise<FileInfo>"
    },
    {
      "path": "ctx.fs.mkdir",
      "summary": "创建目录，可递归",
      "execution": "engine",
      "lifetime": "both",
      "signature": "mkdir(path: string, options?: Recursive): Promise<boolean>"
    },
    {
      "path": "ctx.fs.move",
      "summary": "移动至完整目标路径，可跨文件系统",
      "execution": "engine",
      "lifetime": "both",
      "signature": "move(path: string, destination: string): Promise<boolean>"
    },
    {
      "path": "ctx.fs.read",
      "summary": "分块读取，返回 base64/bytes/eof",
      "execution": "engine",
      "lifetime": "both",
      "signature": "read(path: string, offset?: number, count?: number): Promise<FileChunk>"
    },
    {
      "path": "ctx.fs.readBytes",
      "summary": "本地原生字节读取，避免 Base64",
      "execution": "engine",
      "lifetime": "both",
      "signature": "readBytes(path: string, offset?: number, count?: number): Promise<Uint8Array>"
    },
    {
      "path": "ctx.fs.readlink",
      "summary": "读取符号链接目标",
      "execution": "engine",
      "lifetime": "both",
      "signature": "readlink(path: string): Promise<string>"
    },
    {
      "path": "ctx.fs.remove",
      "summary": "删除文件或目录；目录递归须显式指定",
      "execution": "engine",
      "lifetime": "both",
      "signature": "remove(path: string, options?: Recursive): Promise<boolean>"
    },
    {
      "path": "ctx.fs.rename",
      "summary": "同目录改名；newName 是名称，不是路径",
      "execution": "engine",
      "lifetime": "both",
      "signature": "rename(path: string, newName: string): Promise<boolean>"
    },
    {
      "path": "ctx.fs.source",
      "summary": "为当前调用链创建源文件句柄",
      "execution": "host",
      "lifetime": "both",
      "signature": "source(path: string): Promise<string>"
    },
    {
      "path": "ctx.fs.sourceInfo",
      "summary": "读取当前调用链源文件大小及变更标识",
      "execution": "host",
      "lifetime": "both",
      "signature": "sourceInfo(): Promise<SourceInfo>"
    },
    {
      "path": "ctx.fs.sourceSHA1",
      "summary": "流式计算当前源文件完整 SHA1",
      "execution": "host",
      "lifetime": "both",
      "signature": "sourceSHA1(): Promise<string>"
    },
    {
      "path": "ctx.fs.stat",
      "summary": "读取文件信息，跟随符号链接",
      "execution": "engine",
      "lifetime": "both",
      "signature": "stat(path: string): Promise<FileInfo>"
    },
    {
      "path": "ctx.fs.statMany",
      "summary": "FileError> | 批量读取信息，逐项返回错误",
      "execution": "engine",
      "lifetime": "both",
      "signature": "statMany(paths: string[]): Promise<Array<FileInfo>"
    },
    {
      "path": "ctx.fs.symlink",
      "summary": "创建符号链接",
      "execution": "engine",
      "lifetime": "both",
      "signature": "symlink(target: string, linkPath: string): Promise<boolean>"
    },
    {
      "path": "ctx.fs.truncate",
      "summary": "调整文件长度",
      "execution": "engine",
      "lifetime": "both",
      "signature": "truncate(path: string, size: number): Promise<boolean>"
    },
    {
      "path": "ctx.fs.write",
      "summary": "覆盖写入 Base64 数据",
      "execution": "engine",
      "lifetime": "both",
      "signature": "write(path: string, base64: string): Promise<boolean>"
    },
    {
      "path": "ctx.fs.writeAt",
      "summary": "指定偏移写入",
      "execution": "engine",
      "lifetime": "both",
      "signature": "writeAt(path: string, bytes: Uint8Array, offset: number): Promise<boolean>"
    },
    {
      "path": "ctx.fs.writeBytes",
      "summary": "原生字节覆盖写入",
      "execution": "engine",
      "lifetime": "both",
      "signature": "writeBytes(path: string, bytes: Uint8Array): Promise<boolean>"
    },
    {
      "path": "ctx.host.capabilities",
      "summary": "完整 SDK 目录；只读静态元数据",
      "execution": "host",
      "lifetime": "both",
      "signature": "capabilities(): Promise<Capabilities>"
    },
    {
      "path": "ctx.host.info",
      "summary": "当前包身份、依赖名称绑定、执行链、平台与运行预算",
      "execution": "host",
      "lifetime": "both",
      "signature": "info(): Promise<HostInfo>"
    },
    {
      "path": "ctx.host.resources",
      "summary": "分页发现插件和官方组件；不启动模块",
      "execution": "host",
      "lifetime": "both",
      "signature": "resources(query?: ResourceQuery): Promise<ResourcePage>"
    },
    {
      "path": "ctx.html.title",
      "summary": "从 HTML 文本提取标题",
      "execution": "host",
      "lifetime": "both",
      "signature": "title(html: string): Promise<string>"
    },
    {
      "path": "ctx.http.readContent",
      "summary": "托管下载域名的范围读取或流式摘要",
      "execution": "host",
      "lifetime": "both",
      "signature": "readContent(options: ContentRequest): Promise<ContentResult>"
    },
    {
      "path": "ctx.http.request",
      "summary": "托管凭据请求；限定声明的公网 HTTPS 域名，不跟随跳转",
      "execution": "host",
      "lifetime": "both",
      "signature": "request(options: ScopedHTTPRequest): Promise<ScopedHTTPResponse>"
    },
    {
      "path": "ctx.http.text",
      "summary": "HTTP/HTTPS 文本快捷读取；非 2xx 抛错",
      "execution": "engine",
      "lifetime": "both",
      "signature": "text(url: string): Promise<string>"
    },
    {
      "path": "ctx.invoke",
      "summary": "统一即时信封调用；原生流操作返回 StreamHandle",
      "execution": "host",
      "lifetime": "both",
      "signature": "invoke(request: Call): Promise<CallResult>"
    },
    {
      "path": "ctx.log.error",
      "summary": "写入插件日志（error）",
      "execution": "engine",
      "lifetime": "both",
      "signature": "error(...values: unknown[]): Promise<boolean>"
    },
    {
      "path": "ctx.log.info",
      "summary": "写入插件日志（info），在控制台「日志」页按插件查看；每次执行最多 500 行",
      "execution": "engine",
      "lifetime": "both",
      "signature": "info(...values: unknown[]): Promise<boolean>"
    },
    {
      "path": "ctx.log.warn",
      "summary": "写入插件日志（warning）",
      "execution": "engine",
      "lifetime": "both",
      "signature": "warn(...values: unknown[]): Promise<boolean>"
    },
    {
      "path": "ctx.net.accept",
      "summary": "接收监听器连接；常驻服务在循环中调用",
      "execution": "engine",
      "lifetime": "both",
      "signature": "accept(options: AcceptOptions): Promise<SocketHandle>"
    },
    {
      "path": "ctx.net.close",
      "summary": "关闭指定连接或监听器",
      "execution": "engine",
      "lifetime": "both",
      "signature": "close(options: CloseOptions): Promise<boolean>"
    },
    {
      "path": "ctx.net.connect",
      "summary": "容器内 TCP/UDP/Unix/IP 拨号及可选 TLS",
      "execution": "engine",
      "lifetime": "both",
      "signature": "connect(options: SocketOptions): Promise<SocketHandle>"
    },
    {
      "path": "ctx.net.interfaces",
      "summary": "容器网络接口、地址和 MTU",
      "execution": "engine",
      "lifetime": "both",
      "signature": "interfaces(): Promise<NetworkInterface[]>"
    },
    {
      "path": "ctx.net.listen",
      "summary": "容器内监听 TCP/UDP/Unix/IP 及可选 TLS",
      "execution": "engine",
      "lifetime": "both",
      "signature": "listen(options: SocketOptions): Promise<SocketHandle>"
    },
    {
      "path": "ctx.net.lookup",
      "summary": "容器 DNS 查询",
      "execution": "engine",
      "lifetime": "both",
      "signature": "lookup(options: LookupOptions): Promise<string[]>"
    },
    {
      "path": "ctx.net.read",
      "summary": "分块接收网络数据，data 为 Base64",
      "execution": "engine",
      "lifetime": "both",
      "signature": "read(options: SocketRead): Promise<SocketData>"
    },
    {
      "path": "ctx.net.readBytes",
      "summary": "分块接收原生字节，data 为 Uint8Array",
      "execution": "engine",
      "lifetime": "both",
      "signature": "readBytes(options: SocketRead): Promise<SocketData>"
    },
    {
      "path": "ctx.net.request",
      "summary": "HTTP/HTTPS 请求，支持 UA、代理、TLS、原生字节和文件流",
      "execution": "engine",
      "lifetime": "both",
      "signature": "request(options: NetworkRequest): Promise<NetworkResponse>"
    },
    {
      "path": "ctx.net.write",
      "summary": "发送原生字节或 Base64，返回实际写入长度",
      "execution": "engine",
      "lifetime": "both",
      "signature": "write(options: SocketWrite): Promise<number>"
    },
    {
      "path": "ctx.notify.send",
      "summary": "经已配置的 TG/企微渠道发送消息，遵循渠道限流",
      "execution": "host",
      "lifetime": "both",
      "signature": "send(message: Notification): Promise<NotificationReceipt>"
    },
    {
      "path": "ctx.operations",
      "summary": "按需发现 JS、组件或原生 RPC 契约",
      "execution": "host",
      "lifetime": "both",
      "signature": "operations(target: string, instance: string, operation?: string): Promise<JSONValue>"
    },
    {
      "path": "ctx.remaining",
      "summary": "距本次执行截止还剩的毫秒数；常驻服务为 Infinity",
      "execution": "engine",
      "lifetime": "both",
      "signature": "remaining(): number"
    },
    {
      "path": "ctx.secrets.issue",
      "summary": "为父执行签发临时账号凭据句柄，不落业务明文",
      "execution": "host",
      "lifetime": "both",
      "signature": "issue(grant: CredentialGrant): Promise<CredentialHandle>"
    },
    {
      "path": "ctx.secrets.open",
      "summary": "按本插件身份及 purpose 解密密封数据",
      "execution": "host",
      "lifetime": "both",
      "signature": "open(purpose: string, sealed: string): Promise<string>"
    },
    {
      "path": "ctx.secrets.seal",
      "summary": "凭据提供插件用宿主密钥密封自身数据",
      "execution": "host",
      "lifetime": "both",
      "signature": "seal(purpose: string, value: string): Promise<string>"
    },
    {
      "path": "ctx.service.ready",
      "summary": "报告服务已就绪并附带信息；服务须先调用它",
      "execution": "engine",
      "lifetime": "service",
      "signature": "ready(info?: JSONObject): Promise<boolean>"
    },
    {
      "path": "ctx.services.list",
      "summary": "本插件已登记常驻服务的状态",
      "execution": "host",
      "lifetime": "both",
      "signature": "list(): Promise<ServiceStatus[]>"
    },
    {
      "path": "ctx.services.restart",
      "summary": "请求重启本插件服务",
      "execution": "host",
      "lifetime": "both",
      "signature": "restart(name: string, input?: JSONObject): Promise<ServiceStatus>"
    },
    {
      "path": "ctx.services.start",
      "summary": "请求启动本插件常驻服务；返回受理状态",
      "execution": "host",
      "lifetime": "both",
      "signature": "start(name: string, input?: JSONObject): Promise<ServiceStatus>"
    },
    {
      "path": "ctx.services.stop",
      "summary": "请求停止本插件服务并回收资源",
      "execution": "host",
      "lifetime": "both",
      "signature": "stop(name: string): Promise<ServiceStatus>"
    },
    {
      "path": "ctx.sleep",
      "summary": "等待指定毫秒数",
      "execution": "engine",
      "lifetime": "both",
      "signature": "sleep(ms: number): Promise<boolean>"
    },
    {
      "path": "ctx.store.get",
      "summary": "读取本插件 KV，缺失为 null",
      "execution": "host",
      "lifetime": "both",
      "signature": "get(key: string): Promise<JSONValue>"
    },
    {
      "path": "ctx.store.list",
      "summary": "列出最多 100 项 KV",
      "execution": "host",
      "lifetime": "both",
      "signature": "list(): Promise<KVEntry[]>"
    },
    {
      "path": "ctx.store.put",
      "summary": "写入本插件 KV",
      "execution": "host",
      "lifetime": "both",
      "signature": "put(key: string, value: JSONValue): Promise<boolean>"
    },
    {
      "path": "ctx.stream",
      "summary": "原生流的 next/send/end/cancel；句柄绑定执行链",
      "execution": "host",
      "lifetime": "both",
      "signature": "stream(id: string, command: string, data?: JSONObject): Promise<JSONValue>"
    },
    {
      "path": "ctx.system.exec",
      "summary": "容器内直接执行命令；返回退出码及有界输出，生命周期回收子进程",
      "execution": "engine",
      "lifetime": "both",
      "signature": "exec(program: string, argv?: string[]): Promise<CommandResult>"
    },
    {
      "path": "ctx.viewer",
      "summary": "当前独立门户用户；无身份时为 null",
      "execution": "host",
      "lifetime": "both",
      "signature": "viewer(): Promise<Viewer>"
    }
  ],
  "properties": [
    {
      "path": "ctx.runId",
      "description": "当前执行 ID"
    },
    {
      "path": "ctx.service",
      "description": "仅常驻服务上下文存在；普通动作中为 undefined"
    },
    {
      "path": "ctx.service.stopped",
      "description": "收到停止请求时完成的 Promise；之后有宽限期可清理"
    },
    {
      "path": "ctx.service.stopping",
      "description": "是否已收到停止请求"
    },
    {
      "path": "ctx.deadline",
      "description": "本次执行的截止时间（毫秒时间戳）；常驻服务为 null"
    }
  ],
  "runtime": {
    "engine": "QuickJS (quickjs-go v0.7.7)",
    "globals": [
      "Promise",
      "Uint8Array",
      "ArrayBuffer",
      "JSON",
      "Date",
      "Map",
      "Set",
      "setTimeout",
      "setInterval",
      "clearTimeout",
      "clearInterval",
      "console"
    ],
    "unavailable": [
      "Node.js APIs",
      "Python",
      "DOM",
      "fetch",
      "WebSocket",
      "TextEncoder",
      "TextDecoder",
      "external module loader"
    ]
  },
  "limits": {
    "jsonBytes": 262144,
    "shortActionHeapBytes": 25165824,
    "callDepth": 4,
    "kvListItems": 100,
    "sqlRows": 200,
    "sqlResultBytes": 131072,
    "fileChunkBytes": 4194304,
    "networkBufferDefaultBytes": 4194304,
    "networkBufferMaxBytes": 16777216,
    "serviceHeapDefaultMiB": 24,
    "serviceHeapMinMiB": 8,
    "serviceHeapMaxMiB": 256,
    "resourcePageMax": 100,
    "concurrentHostCalls": 64,
    "pendingHostCalls": 4096,
    "timers": 1000,
    "logLinesPerRun": 500
  },
  "notes": [
    "这是实际 SDK 入口目录；签名细节以 tide.d.ts 及各组件、插件的操作契约为准。",
    "所有方法返回 Promise，可用 Promise.all 并发。插件在宿主进程内的独立 QuickJS 运行时中执行；engine 在运行时旁的协程中执行，host 经宿主接口处理。",
    "插件沿用基座容器身份和网络；卷、内核 capability 与 Docker 端口映射由部署决定。",
    "普通动作结束即回收资源；需要监听或长连接时声明 services：服务入口调用 ctx.service.ready() 后保持运行，await ctx.service.stopped 后清理并返回。",
    "资源目录不启动模块，不包含凭据；enabled/installed 状态不保证依赖、授权或外部配置已就绪。",
    "组件安装状态只反映安装记录；原生能力以容器实际提供的二进制及内核支持为准。",
    "不要将大型文件和响应体通过 JSON 控制通道返回；使用分块、文件路径或源文件句柄。"
  ],
  "componentSDK": {
    "format": "tide.component-rpc/1",
    "runtime": "official Go action workers",
    "transport": "inherited Unix stream FD",
    "maxPending": 8,
    "maxJSONBytes": 262144,
    "methods": [
      "host.info",
      "host.resources",
      "host.capabilities",
      "operations",
      "invoke",
      "stream",
      "log"
    ],
    "files": [
      "component-client.go",
      "component-wire.go",
      "component-serve.go",
      "component-rpc.schema.json"
    ]
  },
  "errors": {
    "fields": "SDK 调用失败时 Promise 以 Error 拒绝，带 code 与 retryable；插件抛出的 Error 可自带 code，会原样传给调用方，HTTP 响应体也带 code",
    "codes": {
      "invalid_input": "参数或输入不符合接口",
      "not_found": "目标、动作或资源不存在",
      "forbidden": "调用方无权",
      "conflict": "状态或幂等冲突",
      "disabled": "插件或分组未运行",
      "busy": "排队或并发已满（可重试）",
      "timeout": "超过截止时间（可重试）",
      "unavailable": "依赖或组件未就绪（可重试）",
      "upstream": "网络或远端服务失败（可重试）",
      "cancelled": "调用方已取消",
      "failed": "其他失败，包括插件异常"
    }
  }
}
