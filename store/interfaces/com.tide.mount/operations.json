            },
            "negativeTtlSec": {
              "type": [
                "integer"
              ],
              "description": "不存在的文件名缓存"
            },
            "linkTtlSec": {
              "type": [
                "integer"
              ],
              "description": "链接最长使用时间"
            },
            "userAgent": {
              "type": [
                "string"
              ],
              "description": "下载 User-Agent"
            },
            "cacheMode": {
              "type": [
                "string"
              ],
              "description": "缓存模式"
            },
            "quotaGiB": {
              "type": [
                "integer"
              ],
              "description": "单个挂载项配额"
            },
            "downloadsPerAccount": {
              "type": [
                "integer"
              ],
              "description": "单账号并发下载"
            },
            "listQps": {
              "type": [
                "number",
                "integer"
              ],
              "description": "列目录速率"
            },
            "listBurst": {
              "type": [
                "integer"
              ],
              "description": "列目录突发"
            },
            "listConcurrency": {
              "type": [
                "integer"
              ],
              "description": "列目录并发"
            },
            "pollEnabled": {
              "type": [
                "boolean"
              ],
              "description": "轮询网盘变更"
            },
            "pollIntervalSec": {
              "type": [
                "integer"
              ],
              "description": "轮询间隔"
            },
            "preheatEnabled": {
              "type": [
                "boolean"
              ],
              "description": "定时预热目录"
            },
            "preheatDepth": {
              "type": [
                "integer"
              ],
              "description": "预热深度"
            },
            "preheatPaths": {
              "type": [
                "array"
              ],
              "description": "预热目录",
              "items": {
                "type": [
                  "string"
