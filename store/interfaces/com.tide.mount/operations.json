                "string"
              ],
              "description": "挂载点"
            },
            "allowOther": {
              "type": [
                "boolean"
              ],
              "description": "允许其他用户访问"
            },
            "uid": {
              "type": [
                "integer"
              ],
              "description": "文件所有者 UID"
            },
            "gid": {
              "type": [
                "integer"
              ],
              "description": "文件所属组 GID"
            },
            "dirMode": {
              "type": [
                "string"
              ],
              "description": "目录权限"
            },
            "fileMode": {
              "type": [
                "string"
              ],
              "description": "文件权限"
            },
            "readOnly": {
              "type": [
                "boolean"
              ],
              "description": "全局只读"
            },
            "attrTimeoutSec": {
              "type": [
                "integer"
              ],
              "description": "内核属性缓存"
            },
            "entryTimeoutSec": {
              "type": [
                "integer"
              ],
              "description": "内核目录项缓存"
            },
            "negativeTimeoutSec": {
              "type": [
                "integer"
              ],
              "description": "内核「不存在」缓存"
            },
            "logLevel": {
              "type": [
                "string"
              ],
              "description": "日志级别"
            },
            "dirTtlHotSec": {
              "type": [
                "integer"
              ],
              "description": "常用目录有效期"
            },
            "dirTtlColdSec": {
              "type": [
                "integer"
              ],
              "description": "其他目录有效期"
            },
            "hotWindowSec": {
              "type": [
                "integer"
              ],
              "description": "判定为常用目录的时间窗"
            },
            "negativeTtlSec": {
              "type": [
                "integer"
              ],
              "description": "不存在的文件名缓存"
            },
            "staleWhileRevalidate": {
              "type": [
                "boolean"
              ],
              "description": "过期后先返回旧数据"
            },
            "memoryEntries": {
              "type": [
                "integer"
              ],
              "description": "内存缓存条目上限"
            },
            "persist": {
              "type": [
                "boolean"
              ],
