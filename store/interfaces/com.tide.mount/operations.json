        "outputPath": {
          "type": [
            "string"
          ],
          "description": "缓存目录 proxy 下尚不存在的文件"
        }
      },
      "required": [
        "mount",
        "entry",
        "url",
        "offset",
        "length",
        "outputPath"
      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "status、bytes",
      "additionalProperties": true
    },
