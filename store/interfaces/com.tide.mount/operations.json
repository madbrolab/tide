    "example": {
      "args": {
        "mount": "x",
        "entry": {
          "id": "1"
        },
        "url": "https://example.quark.cn/f",
        "offset": 0,
        "length": 4194304,
        "outputPath": "/data/plugins/com.tide.mount/cache/proxy/1.part"
      },
      "result": {
        "status": 206,
        "bytes": 4194304
      }
    }
  },
