  "driver-read": {
    "summary": "代读一段数据",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "mount": {
          "type": [
            "string"
          ],
          "description": "挂载项 ID"
        },
        "entry": {
          "type": [
            "object"
          ],
          "description": "驱动返回的条目：id、parentId、name、dir、size、mtime、ctime、hash、version、ref",
          "additionalProperties": true
        },
        "url": {
          "type": [
            "string"
          ],
          "description": "driver-url 返回的链接"
        },
        "offset": {
          "type": [
            "integer"
          ],
          "description": "起始字节"
        },
        "length": {
          "type": [
            "integer"
          ],
          "description": "字节数，最多 64 MiB"
