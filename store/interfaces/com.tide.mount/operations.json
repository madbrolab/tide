            },
            "pruneDays": {
              "type": [
                "integer"
              ],
              "description": "清理多久未访问的目录"
            },
            "maxEntriesPerMount": {
              "type": [
                "integer"
              ],
              "description": "每个挂载项最多缓存"
            },
            "listPageSize": {
              "type": [
                "integer"
              ],
              "description": "列目录每页数量"
            },
            "duplicateNames": {
              "type": [
                "string"
              ],
              "description": "同名文件显示方式"
            },
            "linkTtlSec": {
              "type": [
                "integer"
              ],
              "description": "链接最长使用时间"
            },
            "linkRefreshBeforeSec": {
              "type": [
                "integer"
              ],
              "description": "提前刷新链接"
            },
            "maxLinks": {
              "type": [
                "integer"
              ],
              "description": "链接缓存上限"
            },
            "userAgent": {
              "type": [
                "string"
              ],
              "description": "下载 User-Agent"
            },
            "cacheDir": {
              "type": [
                "string"
              ],
              "description": "缓存目录"
            },
            "cacheMode": {
              "type": [
                "string"
              ],
              "description": "缓存模式"
            },
            "capacityGiB": {
              "type": [
                "integer"
              ],
              "description": "缓存总容量"
            },
            "quotaGiB": {
              "type": [
                "integer"
              ],
              "description": "单个挂载项配额"
            },
            "minFreePercent": {
              "type": [
                "integer"
              ],
              "description": "磁盘最少保留空闲"
            },
            "highWatermark": {
              "type": [
                "integer"
              ],
              "description": "开始淘汰的用量"
            },
            "lowWatermark": {
              "type": [
                "integer"
              ],
              "description": "淘汰到的用量"
            },
            "blockSizeMiB": {
              "type": [
                "string"
              ],
              "description": "数据块大小"
            },
            "headTailMiB": {
              "type": [
                "integer"
              ],
              "description": "头尾优先区大小"
            },
            "policy": {
              "type": [
                "string"
              ],
              "description": "淘汰策略"
            },
            "protectedPercent": {
              "type": [
                "integer"
              ],
              "description": "保护段占比"
            },
            "maxAgeDays": {
              "type": [
                "integer"
              ],
              "description": "数据块最长保留"
            },
            "readaheadMinBlocks": {
              "type": [
                "integer"
              ],
              "description": "顺序读预读起始"
            },
            "readaheadMaxBlocks": {
              "type": [
                "integer"
              ],
              "description": "顺序读预读上限"
            },
            "streamsPerFile": {
              "type": [
                "integer"
              ],
              "description": "单文件并发下载"
            },
            "downloadsPerAccount": {
              "type": [
                "integer"
              ],
              "description": "单账号并发下载"
            },
            "requestTimeoutSec": {
              "type": [
                "integer"
              ],
              "description": "下载请求超时"
            },
            "retries": {
              "type": [
                "integer"
              ],
              "description": "下载失败重试"
            },
            "listQps": {
              "type": [
                "number",
                "integer"
              ],
              "description": "列目录速率"
            },
            "listBurst": {
              "type": [
                "integer"
              ],
              "description": "列目录突发"
            },
            "listConcurrency": {
              "type": [
                "integer"
              ],
              "description": "列目录并发"
            },
            "riskBackoffMaxSec": {
              "type": [
                "integer"
              ],
              "description": "风控退避上限"
            },
            "pollEnabled": {
              "type": [
                "boolean"
              ],
              "description": "轮询网盘变更"
            },
            "pollIntervalSec": {
              "type": [
                "integer"
              ],
              "description": "轮询间隔"
            },
            "preheatEnabled": {
              "type": [
                "boolean"
              ],
              "description": "定时预热目录"
            },
            "preheatWindow": {
              "type": [
                "string"
              ],
              "description": "预热时段"
            },
            "preheatDepth": {
              "type": [
                "integer"
              ],
              "description": "预热深度"
            },
            "preheatPaths": {
              "type": [
                "array"
              ],
              "description": "预热目录",
              "items": {
                "type": [
                  "string"
                ],
                "description": "路径"
              }
            },
            "writeEnabled": {
              "type": [
                "boolean"
              ],
              "description": "允许写入"
            },
            "stagingDir": {
              "type": [
                "string"
              ],
              "description": "上传暂存目录"
            },
            "uploadConcurrency": {
              "type": [
                "integer"
              ],
              "description": "上传并发"
            },
            "uploadDelaySec": {
              "type": [
                "integer"
              ],
              "description": "关闭后开始上传的等待时间"
            },
            "conflict": {
              "type": [
                "string"
              ],
              "description": "同名冲突"
            }
          }
        },
        "revision": {
          "type": [
            "integer"
          ],
          "description": "读取时的版本，用于防止覆盖他人修改"
        }
      },
      "required": [
        "values"
      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "保存后的设置",
      "additionalProperties": true
    },
    "example": {
      "args": {
        "values": {
          "capacityGiB": 20
        }
      },
      "result": {}
    }
