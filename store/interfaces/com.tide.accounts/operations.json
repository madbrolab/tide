    },
    "output": {
      "type": [
        "object"
      ],
      "description": "结果",
      "additionalProperties": true
    },
    "example": {
      "args": {
        "uuid": "1",
        "kind": "cookie",
        "label": "家庭"
      },
      "result": {
        "saved": true
      }
    }
  },
