{
  "list": {
    "summary": "列出账号",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "offset": {
          "type": [
            "integer"
          ],
          "description": "起始位置"
        },
        "limit": {
          "type": [
            "integer"
          ],
          "description": "数量 1–100"
        },
        "provider": {
          "type": [
            "string"
          ],
          "description": "网盘 ID",
          "enum": [
            "cloud115",
            "guangya",
            "cloud123",
            "cloud189",
            "quark"
          ]
        },
        "status": {
          "type": [
            "string"
          ],
          "description": "按状态筛选：ok、expired、error、attention"
        }
      }
    },
    "output": {
      "type": [
        "array"
      ],
      "description": "账号连接",
      "items": {
        "type": [
          "object"
        ],
        "description": "账号连接（不含凭据）",
        "additionalProperties": true
      }
    },
    "example": {
      "args": {
        "limit": 20
      },
      "result": []
    }
  },
  "get": {
    "summary": "读取一个账号",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "uuid": {
          "type": [
            "string"
          ],
          "description": "账号 UUID"
        },
        "kind": {
          "type": [
            "string"
          ],
          "description": "连接方式：cookie、bearer 或 session；省略时使用该网盘的首选方式"
        }
      },
      "required": [
        "uuid"
      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "账号连接（不含凭据）",
      "additionalProperties": true
    },
    "example": {
      "args": {
        "uuid": "1"
      },
      "result": {}
    }
  },
