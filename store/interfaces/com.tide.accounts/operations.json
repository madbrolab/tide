  "acquire": {
    "summary": "取得本次调用专用的凭据句柄",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "uuid": {
          "type": [
            "string"
          ],
          "description": "账号 UUID"
        },
        "kind": {
          "type": [
            "string"
          ],
          "description": "连接方式：cookie、bearer 或 session；省略时使用该网盘的首选方式"
        }
      },
      "required": [
        "uuid"
      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "uuid、credential 句柄与目标连接器",
      "additionalProperties": true
    },
    "notes": "仅限使用凭据句柄的网盘（115、光鸭）。句柄只在本次调用链内有效，只能交给返回的 connector。会话票据网盘请使用 call。",
    "example": {
      "args": {
        "uuid": "1",
        "kind": "cookie"
      },
      "result": {
        "uuid": "1",
        "credential": {
          "kind": "cookie",
          "handle": "h"
        },
        "connector": "com.tide.cloud115"
      }
    }
  },
  "call": {
    "summary": "以账号身份调用网盘连接器",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "uuid": {
          "type": [
            "string"
          ],
          "description": "账号 UUID"
        },
        "kind": {
          "type": [
            "string"
          ],
          "description": "连接方式：cookie、bearer 或 session；省略时使用该网盘的首选方式"
        },
        "operation": {
          "type": [
            "string"
          ],
          "description": "连接器动作名"
        },
        "args": {
          "type": [
            "object"
          ],
          "description": "动作参数，原样转发",
          "additionalProperties": true
        },
        "userAgent": {
          "type": [
            "string"
          ],
          "description": "可选 User-Agent"
        },
        "headers": {
          "type": [
            "object"
          ],
          "description": "可选请求头，规则同调用信封",
          "additionalProperties": true
        },
        "timeoutMs": {
          "type": [
            "integer"
          ],
          "description": "可选超时毫秒数"
        }
      },
      "required": [
        "uuid",
        "operation"
      ]
    },
    "output": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "description": "连接器返回值",
      "additionalProperties": true,
      "items": {
        "type": [
          "object"
        ],
        "description": "值",
        "additionalProperties": true
      }
    },
    "notes": "账号中心注入凭据或会话票据后调用账号所属的连接器，适用于所有网盘。连接器续期返回的新会话由账号中心保存，不出现在返回值中。登录、会话管理类动作被拒绝。",
    "example": {
      "args": {
        "uuid": "1",
        "operation": "fs-files",
        "args": {}
      },
      "result": {}
    }
  },
  "edit": {
    "summary": "保存名称和备注",
    "input": {
