  "configure": {
    "summary": "校验并保存粘贴的凭据",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "provider": {
          "type": [
            "string"
          ],
          "description": "网盘 ID",
          "enum": [
            "cloud115",
            "guangya",
            "cloud123",
            "cloud189",
            "quark"
          ]
        },
        "kind": {
          "type": [
            "string"
          ],
          "description": "连接方式"
        },
        "uuid": {
          "type": [
            "string"
          ],
          "description": "要替换或导入的账号 UUID"
        },
        "adopt": {
          "type": [
            "boolean"
          ],
          "description": "uuid 不存在时以此 UUID 新建（导入用）"
        },
        "value": {
          "type": [
            "string"
          ],
          "description": "Cookie、令牌或 token"
        },
        "refreshToken": {
          "type": [
            "string"
          ],
          "description": "刷新令牌"
        },
        "expires": {
          "type": [
            "integer"
          ],
          "description": "访问令牌到期时间，毫秒"
        },
        "client": {
          "type": [
            "string"
          ],
          "description": "登录设备或 AppID"
        },
        "label": {
          "type": [
            "string"
          ],
          "description": "显示名称"
        },
        "note": {
          "type": [
            "string"
          ],
          "description": "备注"
        }
      },
      "required": [
        "provider",
        "value"
      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "账号连接（不含凭据）",
      "additionalProperties": true
    },
    "example": {
      "args": {
        "provider": "cloud115",
        "kind": "cookie",
        "value": "UID=1_A1; CID=x; SEID=x"
      },
      "result": {}
    }
  },
