{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "当前单次调用的网络出口",
  "$defs": {
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "description": "按目标域名匹配。空清单全部直连。单独的 * 匹配全部；普通域名精确匹配，*.域名 匹配子域。保存时统一 IDNA 并校验 DNS 标签。",
      "items": {"type":"string","minLength":1,"maxLength":255,"pattern":"^(?:\\*|(?:\\*\\.)?[^*\\s/:?#@\\\\]+)$"},
      "if": {"contains": {"const":"*"}},
      "then": {"maxItems":1}
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {"mode": {"enum": ["direct", "system"]}}
    },
    {
      "type": "object", "additionalProperties": false, "required": ["mode", "profile"],
      "properties": {"mode": {"const": "custom"}, "profile": {"type": "string", "minLength": 1, "maxLength": 80}}
    },
    {
      "type": "object", "additionalProperties": false, "required": ["mode", "url", "domains"],
      "properties": {
        "mode": {"const": "custom"},
        "url": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^(?:https?|socks5)://[^/?#@\\s]+/?$", "description": "临时代理端点。运行时解析并校验主机、端口与授权范围，认证单独传入。"},
        "domains": {"$ref": "#/$defs/domains"},
        "authRef": {"type": "string", "minLength": 1, "maxLength": 256, "writeOnly": true}
      }
    }
  ]
}
