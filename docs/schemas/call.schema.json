{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "当前模块调用信封（SDK 1）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "operation",
    "args"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "target": {
      "description": "@名称、实际插件包 ID，或官方组件 ID；不支持 cap: 别名或 provider 选择。",
      "anyOf": [
        {
          "$ref": "plugin-manifest.schema.json#/$defs/callName"
        },
        {
          "$ref": "plugin-manifest.schema.json#/$defs/packageId"
        },
        {
          "$ref": "#/$defs/component"
        }
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "args": {
      "type": "object"
    },
    "route": {
      "$ref": "network-route.schema.json",
      "description": "仅在本次调用选择出口时提供。省略时继承上级策略。"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$",
      "description": "连接器账号的稳定标识，扫码引导动作无需提供"
    },
    "userAgent": {
      "type": "string",
      "maxLength": 512
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "description": "连接器获准的 HTTPS 源站"
    },
    "headers": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "type": "string",
        "maxLength": 2048
      },
      "description": "支持 Accept、Accept-Language、Origin、Referer、User-Agent、Cache-Control"
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cookie",
            "bearer"
          ]
        },
        "inline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "writeOnly": true
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "oneOf": [
        {
          "required": [
            "inline"
          ]
        },
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "handle"
          ]
        }
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000,
      "description": "省略时使用目标默认值；普通工具组件单次最大 100000 ms，调用链还受父截止时间限制。"
    }
  },
  "$defs": {
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "description": "已登记的官方组件 ID；亦接受历史短插件 ID，由宿主解析目标。"
    }
  }
}
