{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tide.encrypted/1 外层 package.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "algorithm",
    "key"
  ],
  "properties": {
    "format": {
      "const": "tide.encrypted/1"
    },
    "algorithm": {
      "const": "RSA-OAEP-SHA256+A256GCM"
    },
    "key": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "由公开打包器自动生成的封装密钥，用户无需配置。"
    }
  }
}
