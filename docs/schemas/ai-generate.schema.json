{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI 模型服务 generate@1 的业务输入",
  "$ref": "#/$defs/request",
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages"
      ],
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 48,
          "description": "留空使用默认模型"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          },
          "maxItems": 128
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          },
          "maxItems": 32
        },
        "outputSchema": {
          "type": "object",
          "description": "需要模型输出的 JSON 值的 Schema"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "inputSchema"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "type": "object"
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callId",
        "name",
        "arguments"
      ],
      "properties": {
        "callId": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "toolCalls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/toolCall"
      }
    },
    "message": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "text"
          ],
          "properties": {
            "role": {
              "enum": [
                "system",
                "user"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "const": "assistant"
            },
            "text": {
              "type": "string"
            },
            "toolCalls": {
              "$ref": "#/$defs/toolCalls"
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "toolCalls"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "callId",
            "text"
          ],
          "properties": {
            "role": {
              "const": "tool"
            },
            "callId": {
              "$ref": "#/$defs/name"
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "inputTokens",
        "outputTokens"
      ],
      "properties": {
        "source": {
          "enum": [
            "provider",
            "unknown"
          ]
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "source": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "inputTokens": {
            "type": "null"
          },
          "outputTokens": {
            "type": "null"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "finish",
        "usage"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/name"
        },
        "finish": {
          "enum": [
            "stop",
            "length",
            "tool_calls"
          ]
        },
        "text": {
          "type": "string"
        },
        "value": {
          "description": "经请求中 outputSchema 验证的 JSON 值"
        },
        "toolCalls": {
          "$ref": "#/$defs/toolCalls"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      },
      "if": {
        "properties": {
          "finish": {
            "const": "tool_calls"
          }
        }
      },
      "then": {
        "required": [
          "toolCalls"
        ]
      },
      "else": {
        "not": {
          "required": [
            "toolCalls"
          ]
        },
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "value"
            ]
          }
        ]
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text.delta"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "result"
          ],
          "properties": {
            "type": {
              "const": "done"
            },
            "result": {
              "$ref": "#/$defs/result"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "code"
          ],
          "properties": {
            "type": {
              "const": "error"
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
