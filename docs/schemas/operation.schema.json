{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "当前 JS 插件 operations.json 操作目录",
  "description": "每个键必须对应 manifest.actions 中一个动作，集合完全一致；每层 Shape 有 description。示例与 Shape 的匹配、嵌套深度和字段引用由构建/安装校验器复核。原生 CD2 RPC 元数据使用自身描述，不使用此目录模式。",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "$ref": "#/$defs/operation"
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "input",
        "output",
        "example"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "allOf": [
            {
              "$ref": "#/$defs/shape"
            },
            {
              "properties": {
                "type": {
                  "const": [
                    "object"
                  ]
                }
              }
            }
          ]
        },
        "output": {
          "$ref": "#/$defs/shape"
        },
        "notes": {
          "type": "string"
        },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "args",
            "result"
          ],
          "properties": {
            "args": {
              "type": "object"
            },
            "result": {}
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "object",
              "array",
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/shape"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "$ref": "#/$defs/shape"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "contains": {
                  "const": "array"
                }
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          },
          "else": {
            "not": {
              "required": [
                "items"
              ]
            }
          }
        }
      ]
    }
  }
}
