{
  "environment": {
    "summary": "获取本次执行环境与预算",
    "input": {
      "type": [
        "object"
      ],
      "description": "无参数",
      "properties": {},
      "required": []
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "当前执行环境",
      "properties": {
        "sdk": {
          "type": [
            "integer"
          ],
          "description": "SDK 版本"
        },
        "timezone": {
          "type": [
            "string"
          ],
          "description": "Asia/Shanghai"
        },
        "os": {
          "type": [
            "string"
          ],
          "description": "GOOS"
        },
        "arch": {
          "type": [
            "string"
          ],
          "description": "GOARCH"
        },
        "plugin": {
          "type": [
            "object"
          ],
          "description": "插件身份",
          "properties": {
            "id": {
              "type": [
                "string"
              ],
              "description": "稳定 ID"
            },
            "name": {
              "type": [
                "string"
              ],
              "description": "显示名称"
            },
            "version": {
              "type": [
                "string"
              ],
              "description": "包版本"
            }
          },
          "required": [
            "id",
            "name",
            "version"
          ]
        },
        "execution": {
          "type": [
            "object"
          ],
          "description": "执行信息",
          "properties": {
            "id": {
              "type": [
                "string"
              ],
              "description": "执行 ID"
            },
            "action": {
              "type": [
                "string"
              ],
              "description": "动作名"
            },
            "chain": {
              "type": [
                "array"
              ],
              "description": "完整调用链",
              "items": {
                "type": [
                  "string"
                ],
                "description": "插件/动作调用地址"
              }
            },
            "lifetime": {
              "type": [
                "string"
              ],
              "description": "action 或 service"
            }
          },
          "required": [
            "id",
            "action",
            "chain",
            "lifetime"
          ]
        },
        "limits": {
          "type": [
            "object"
          ],
          "description": "执行预算",
          "properties": {
            "jsonBytes": {
              "type": [
                "integer"
              ],
              "description": "控制消息上限"
            },
            "jsHeapBytes": {
              "type": [
                "integer"
              ],
              "description": "JS 堆上限，不含原生内存"
            },
            "shortActionSlots": {
              "type": [
                "integer"
              ],
              "description": "短动作调用链名额"
            },
            "defaultActionTimeoutMs": {
              "type": [
                "integer"
              ],
              "description": "默认短动作超时"
            }
          },
          "required": [
            "jsonBytes",
            "jsHeapBytes",
            "shortActionSlots",
            "defaultActionTimeoutMs"
          ]
        },
        "dependencies": {
          "type": [
            "array"
          ],
          "description": "本包声明的依赖与本地调用名称",
          "items": {
            "type": [
              "object"
            ],
            "description": "kind/id/name 及 version 或 minVersion",
            "additionalProperties": true
          }
        }
      },
      "required": [
        "sdk",
        "timezone",
        "os",
        "arch",
        "plugin",
        "execution",
        "limits",
        "dependencies"
      ]
    },
    "example": {
      "args": {},
      "result": {
        "sdk": 1,
        "timezone": "Asia/Shanghai",
        "os": "linux",
        "arch": "amd64",
        "plugin": {
          "id": "com.example.resources",
          "name": "资源示例",
          "version": "1.0.0"
        },
        "execution": {
          "id": "example",
          "action": "environment",
          "chain": [
            "com.example.resources"
          ],
          "lifetime": "action"
        },
        "limits": {
          "jsonBytes": 262144,
          "jsHeapBytes": 25165824,
          "shortActionSlots": 2,
          "defaultActionTimeoutMs": 30000
        },
        "dependencies": []
      }
    }
  },
  "resources": {
    "summary": "分页查询插件或官方组件",
    "input": {
      "type": [
        "object"
      ],
      "description": "查询参数",
      "properties": {
        "kind": {
          "type": [
            "string"
          ],
          "description": "默认 plugin",
          "enum": [
            "plugin",
            "component"
          ]
        },
        "after": {
          "type": [
            "string"
          ],
          "description": "上一页 next，首轮省略"
        },
        "limit": {
          "type": [
            "integer"
          ],
          "description": "1–100，默认 50"
        }
      },
      "required": []
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "资源页",
      "properties": {
        "items": {
          "type": [
            "array"
          ],
          "description": "资源条目",
          "items": {
            "type": [
              "object"
            ],
            "description": "资源条目",
            "properties": {
              "kind": {
                "type": [
                  "string"
                ],
                "description": "plugin 或 component"
              },
              "id": {
                "type": [
                  "string"
                ],
                "description": "包或组件 ID"
              },
              "name": {
                "type": [
                  "string"
                ],
                "description": "界面名称"
              },
              "version": {
                "type": [
                  "string"
                ],
                "description": "版本，未安装组件为空"
              },
              "description": {
                "type": [
                  "string"
                ],
                "description": "插件简介，可省略"
              },
              "state": {
                "type": [
                  "string"
                ],
                "description": "配置状态，不保证可调用"
              },
              "installed": {
                "type": [
                  "boolean"
                ],
                "description": "是否有安装记录；内置组件为 true"
              },
              "contract": {
                "type": [
                  "string"
                ],
                "description": "管理 API 的契约路径"
              }
            },
            "required": [
              "kind",
              "id",
              "name",
              "version",
              "state",
              "installed",
              "contract"
            ]
          }
        },
        "next": {
          "type": [
            "string"
          ],
          "description": "下一页游标，没有后续页时省略"
        }
      },
      "required": [
        "items"
      ]
    },
    "example": {
      "args": {
        "kind": "component",
        "limit": 1
      },
      "result": {
        "items": [
          {
            "kind": "component",
            "id": "cd2",
            "name": "CloudDrive2",
            "version": "",
            "state": "not-installed",
            "installed": false,
            "contract": "/api/v1/components/cd2/contract"
          }
        ],
        "next": "cd2"
      }
    }
  },
  "echo": {
    "summary": "启动 TCP 回声监听",
    "input": {
      "type": [
        "object"
      ],
      "description": "启动配置",
      "properties": {
        "address": {
          "type": [
            "string"
          ],
          "description": "默认 127.0.0.1:0；端口由系统分配"
        }
      },
      "required": []
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "监听结果",
      "properties": {
        "address": {
          "type": [
            "string"
          ],
          "description": "实际监听地址"
        }
      },
      "required": [
        "address"
      ]
    },
    "example": {
      "args": {},
      "result": {
        "address": "127.0.0.1:43123"
      }
    },
    "notes": "仅通过服务管理器启动；地址从服务状态 info.address 读取。示例按事件串行处理，不能用它推断业务负载。"
  }
}
