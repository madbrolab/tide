{
  "sdk": 2,
  "id": "com.example.resources",
  "name": "资源示例",
  "description": "查询基座能力与安装资源，演示按需动作和常驻 TCP 生命周期。",
  "version": "1.0.0",
  "icon": "icon.png",
  "developer": {
    "name": "示例开发者",
    "repository": "https://example.org/tide/resources"
  },
  "actions": {
    "environment": {
      "label": "当前环境",
      "entry": "discovery",
      "external": true
    },
    "resources": {
      "label": "已安装资源",
      "entry": "discovery",
      "external": true
    },
    "echo": {
      "label": "TCP 服务入口",
      "entry": "service"
    }
  },
  "services": {
    "echo": {
      "action": "echo",
      "label": "回声服务",
      "start": "manual",
      "restart": "never",
      "memoryMiB": 8
    }
  }
}
